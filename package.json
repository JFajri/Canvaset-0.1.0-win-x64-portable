{
  "name": "canvaset",
  "version": "0.1.0",
  "description": "Ruang kerja kreatif portabel: desain grafis + catatan, offline-first",
  "main": "main/main.js",
  "directories": {
    "doc": "docs",
    "test": "test"
  },
  "scripts": {
    "test": "node --test \"test/*.test.js\"",
    "start": "electron .",
    "fonts": "node scripts/copy-fonts.js",
    "build:portable": "node scripts/build-portable.js",
    "test:e2e": "xvfb-run -a -s '-screen 0 1600x1000x24' node --test --test-concurrency=1 --test-timeout=180000 \"test/e2e/*.e2e.js\""
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/lora": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "electron": "^44.7.2"
  }
}
